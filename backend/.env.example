# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=optional-only-needed-if-project-still-uses-HS256
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AI
ANTHROPIC_API_KEY=your-anthropic-key
# Google Vision: paste the full service-account JSON as a single-line string on Vercel.
# Locally you can keep GOOGLE_APPLICATION_CREDENTIALS pointing at a key file instead.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Deployment
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://cosello.io
BETA_PASSWORD=your-shared-beta-password
